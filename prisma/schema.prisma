// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id       Int          @id @default(autoincrement())
  email    String       @unique
  password String
  rentals  RentalForm[] // One user can have many rentals
}

model CarMake {
  id     String   @id @default(uuid())
  name   String   @unique
  models CarModel[]
}

model CarModel {
  id           String   @id @default(uuid())
  makeId       String
  make         CarMake  @relation(fields: [makeId], references: [id], onDelete: Cascade)
  modelName    String
  year         Int
  fuelType     String
  transmission String
  price        Int
  mileage      Int
  rentals      RentalForm[] // A car model can be rented multiple times
}

model RentalForm {
  id          Int       @id @default(autoincrement())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Int
  car         CarModel  @relation(fields: [carId], references: [id], onDelete: Cascade)
  carId       String
  pickupDate  DateTime
  dropoffDate DateTime
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}